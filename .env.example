# Only needed if the API isn't reachable via the Vite dev proxy (vite.config.ts)
# or a built bundle needs to point at a different host, e.g. a deployed API.
# VITE_API_BASE_URL=http://localhost:8000

# Only needed for a deployed build where the AWS emulator can hibernate
# (Render free tier). The launch screen pings this URL directly to help wake
# it -- see src/api/readiness.ts. Leave unset locally; docker-compose's
# emulator never sleeps, so there's nothing to wake.
# VITE_LOCALSTACK_URL=https://cloudlab-localstack.onrender.com
